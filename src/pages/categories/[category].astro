---
import BlogCard from "@/components/BlogCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import PageHeader from "@/partials/PageHeader.astro";

// get static paths for all categories
export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const PROJECTS_FOLDER = "projects";
  const categories = [
    ...new Set([
      ...(await getTaxonomy(BLOG_FOLDER, "categories")),
      ...(await getTaxonomy(PROJECTS_FOLDER, "categories")),
    ]),
  ];

  return categories.map((category) => {
    return {
      params: { category },
    };
  });
}

const { category } = Astro.params;

// get posts by category
const BLOG_FOLDER = "blog";
const PROJECTS_FOLDER = "projects";
const posts = await getSinglePage(BLOG_FOLDER);
const projects = await getSinglePage(PROJECTS_FOLDER);
const filteredPosts = taxonomyFilter(posts, "categories", category!).map(
  (entry) => ({
    type: "blog",
    entry,
  }),
);
const filteredProjects = taxonomyFilter(projects, "categories", category!).map(
  (entry) => ({
    type: "projects",
    entry,
  }),
);
const getEntryTimestamp = (date?: Date) => (date ? date.valueOf() : 0);
const sortedItems = [...filteredPosts, ...filteredProjects].sort(
  (a, b) =>
    getEntryTimestamp(b.entry.data.date) - getEntryTimestamp(a.entry.data.date),
);
---

<Base title={category}>
  <PageHeader title={category} />
  <div class="section-sm pb-0">
    <div class="container">
      <div class="row">
        {
          sortedItems.map((item) => (
            <div class="mb-14 md:col-6 lg:col-4">
              {item.type === "blog" ? (
                <BlogCard data={item.entry} />
              ) : (
                <ProjectCard data={item.entry} basePath="projects" />
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>
